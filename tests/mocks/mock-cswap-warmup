#!/usr/bin/env python3
"""Stateful mock cswap for warmup E2E: idle accounts until warmed.

`list --json` -> 2 accounts; an account whose marker file exists reports a
running 5h window (future resetsAt), otherwise an idle one (empty resetsAt).
`run <n> -- cmd...` -> executes cmd (like real cswap) and, on success,
writes the marker.
"""
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

BASE = os.path.dirname(os.path.abspath(__file__))
LOG = os.path.join(BASE, "warmup-cswap-calls.log")


def marker(n):
    return os.path.join(BASE, f"warmed-{n}")


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def account(n, email, warmed):
    if warmed:
        five = {"pct": 0.4,
                "resetsAt": (datetime.now(timezone.utc)
                             + timedelta(hours=5)).isoformat(),
                "countdown": "4h 59m", "clock": ""}
    else:
        five = {"pct": 0.0, "resetsAt": "", "countdown": "", "clock": ""}
    return {"number": n, "email": email, "organizationName": email,
            "active": n == 1, "usageStatus": "ok",
            "usageFetchedAt": now_iso(),
            "usage": {"fiveHour": five,
                      "sevenDay": {"pct": 10.0, "resetsAt": now_iso(),
                                   "countdown": "6d", "clock": ""},
                      "scoped": []}}


def main():
    with open(LOG, "a") as f:
        f.write(f"{time.time():.3f} {' '.join(sys.argv[1:])}\n")
    if len(sys.argv) >= 2 and sys.argv[1] == "list":
        print(json.dumps({"schemaVersion": 1, "activeAccountNumber": 1,
                          "accounts": [
                              account(1, "alpha@test.dev", os.path.exists(marker(1))),
                              account(2, "bravo@test.dev", os.path.exists(marker(2))),
                          ]}))
        return 0
    if len(sys.argv) >= 4 and sys.argv[1] == "run" and sys.argv[3] == "--":
        n = sys.argv[2]
        rc = subprocess.run(sys.argv[4:]).returncode
        if rc == 0:
            with open(marker(n), "w") as f:
                f.write("warm")
        return rc
    print(f"mock: unhandled {sys.argv[1:]}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
