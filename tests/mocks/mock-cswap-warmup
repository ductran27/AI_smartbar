#!/usr/bin/env python3
"""Stateful mock cswap for warmup E2E: idle accounts until warmed.

`list --json` -> 2 accounts; an account whose marker file exists reports a
running 5h window (future resetsAt), otherwise an idle one (empty resetsAt).
`run <n> -- args...` mirrors REAL cswap semantics: the claude binary is
resolved from PATH by cswap itself (session.py does shutil.which), and
everything after `--` is passed to claude as ARGUMENTS — a path-like
claude token there is the v1 runner bug and fails loudly.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

BASE = os.path.dirname(os.path.abspath(__file__))
LOG = os.path.join(BASE, "warmup-cswap-calls.log")


def marker(n):
    return os.path.join(BASE, f"warmed-{n}")


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def account(n, email, warmed):
    if warmed:
        five = {"pct": 0.4,
                "resetsAt": (datetime.now(timezone.utc)
                             + timedelta(hours=5)).isoformat(),
                "countdown": "4h 59m", "clock": ""}
    else:
        five = {"pct": 0.0, "resetsAt": "", "countdown": "", "clock": ""}
    return {"number": n, "email": email, "organizationName": email,
            "active": n == 1, "usageStatus": "ok",
            "usageFetchedAt": now_iso(),
            "usage": {"fiveHour": five,
                      "sevenDay": {"pct": 10.0, "resetsAt": now_iso(),
                                   "countdown": "6d", "clock": ""},
                      "scoped": []}}


def main():
    with open(LOG, "a") as f:
        f.write(f"{time.time():.3f} {' '.join(sys.argv[1:])}\n")
    if len(sys.argv) >= 2 and sys.argv[1] == "list":
        print(json.dumps({"schemaVersion": 1, "activeAccountNumber": 1,
                          "accounts": [
                              account(1, "alpha@test.dev", os.path.exists(marker(1))),
                              account(2, "bravo@test.dev", os.path.exists(marker(2))),
                          ]}))
        return 0
    if len(sys.argv) >= 4 and sys.argv[1] == "run" and sys.argv[3] == "--":
        n = sys.argv[2]
        claude_args = sys.argv[4:]
        # Real cswap resolves `claude` itself (session.py shutil.which) —
        # the runner must make PATH carry it, and must never smuggle the
        # binary path in as an argument.
        claude_bin = shutil.which("claude")
        if not claude_bin:
            print("Error: 'claude' was not found on PATH. Install Claude Code first.",
                  file=sys.stderr)
            return 1
        if claude_args and os.path.sep in claude_args[0]:
            print(f"mock: claude binary path smuggled into args: {claude_args[0]}",
                  file=sys.stderr)
            return 1
        rc = subprocess.run([claude_bin, *claude_args]).returncode
        if rc == 0:
            with open(marker(n), "w") as f:
                f.write("warm")
        return rc
    print(f"mock: unhandled {sys.argv[1:]}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
