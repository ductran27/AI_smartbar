#!/usr/bin/env python3
"""AI_smartbar launcher: OS dispatch, plus --once headless mode."""
import argparse
import os
import sys

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(os.path.abspath(__file__))))
sys.path.insert(0, REPO_ROOT)

from smartbar import __version__  # noqa: E402


def once() -> int:
    from smartbar import presence_client
    from smartbar.core import codex, cswap, model, presence
    try:
        snap = cswap.fetch()
    except cswap.CswapError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    if snap.schema_warning:
        print(f"WARNING: {snap.schema_warning}", file=sys.stderr)
    # Both UIs stamp the device counts before rendering, so the headless view
    # has to as well or it prints a different label than the screen shows for
    # the same data — which is exactly the thing people run --once to check.
    # Read-only: no beat, so a diagnostic never announces this device.
    presence.apply_counts(snap, presence_client.counts())
    snap.openai = codex.accounts()
    account = snap.active_account
    m = model.worst(account)
    icon = "?" if m is None else f"{model.icon_text(account)} ({model.color(m.pct)})"
    print(f"icon:  {icon}")
    print(f"title: {model.title_line(account)}")
    for acct in snap.accounts:
        print(model.menu_row(acct))
    if snap.openai:
        print("openai:")
        for acct in snap.openai:
            print(model.menu_row(acct))
    return 0


def print_config(fmt: str) -> int:
    """Render this device's config.env for whichever agent file wants it.

    The installers shell out to this instead of parsing the file in bash four
    times over: the rules about which keys are honoured and which characters
    can be passed safely to an agent are semantics, so they live in core with
    unit tests behind them.

    `winenv` parses with the widened Windows charset (see device_config.parse):
    that format's only consumer is os.environ on Windows, so it is the one
    caller here that knows a real `C:\\Users\\...` value must survive.

    Never fatal. An installer that cannot read the config must still produce a
    working agent — losing a setting is a papercut, failing to install is not.
    """
    from smartbar.core import device_config
    # presence_runner owns the canonical ~/.config location (and the
    # SMARTBAR_CONFIG_DIR override) because the device id already lives there.
    from smartbar.presence_runner import CONFIG_DIR
    path = os.path.join(CONFIG_DIR, device_config.FILENAME)
    try:
        with open(path) as handle:
            text = handle.read()
    except OSError:
        text = ""
    settings, problems = device_config.parse(text, windows=(fmt == "winenv"))
    for problem in problems:
        print(f"warning: {path}: {problem}", file=sys.stderr)
    try:
        sys.stdout.write(device_config.render(fmt, settings))
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2
    return 0


def _device_config() -> dict:
    """This device's config.env, or {} — never raises, never prints."""
    from smartbar.core import device_config
    from smartbar.presence_runner import CONFIG_DIR
    try:
        with open(os.path.join(CONFIG_DIR, device_config.FILENAME)) as handle:
            return device_config.parse(handle.read())[0]
    except OSError:
        return {}


def print_update_interval(fmt: str) -> int:
    """How often this device should check, for the installers' timers.

    Resolution lives in core.update.check_interval: this process's environment
    beats config.env beats the default. The installers ask rather than reading
    the file themselves so the floor and the cron/minutes arithmetic exist
    once — cron for a Linux box's crontab, minutes for a Windows Task
    Scheduler repetition trigger.
    """
    from smartbar.core import update
    seconds = update.check_interval(
        fallback=_device_config().get("SMARTBAR_UPDATE_INTERVAL", ""))
    if fmt == "cron":
        print(update.cron_spec(seconds))
    elif fmt == "minutes":
        print(update.minutes_spec(seconds))
    elif fmt == "seconds":
        print(int(seconds))
    else:
        print(f"ERROR: unknown interval format {fmt!r} (want seconds, cron "
              "or minutes)", file=sys.stderr)
        return 2
    return 0


def _load_windows_env() -> None:
    """Fold config.env into os.environ before ANY dispatch. win32 only.

    Every other platform bakes config.env into the agent that launches this
    process (render_plist/render_systemd/render_exec_prefix), so by the time
    Python starts the settings are already in os.environ. Windows has no
    env.exe, cmd.exe does not honour a `VAR=value cmd` prefix, and a .lnk
    cannot carry environment variables — so the Startup shortcut and the
    Scheduled Task just launch the bare interpreter, and this process has to
    load its own settings instead. An already-set os.environ key — an
    explicit export, or one the Scheduled Task itself supplies — must win
    over the file, hence setdefault rather than assignment. Silent on the
    happy path: a missing config.env is the common case, and malformed lines
    are already surfaced by --print-config. Deliberately not run on other
    platforms — a hand-run bin/ai-smartbar there has never picked up
    config.env, and changing that is outside this loader's job.
    """
    if sys.platform != "win32":
        return
    from smartbar.core import device_config
    from smartbar.presence_runner import CONFIG_DIR
    try:
        with open(os.path.join(CONFIG_DIR, device_config.FILENAME)) as handle:
            text = handle.read()
    except OSError:
        return
    settings, _ = device_config.parse(text, windows=True)
    for key, value in settings.items():
        os.environ.setdefault(key, value)


def main() -> int:
    _load_windows_env()
    parser = argparse.ArgumentParser(prog="ai-smartbar",
                                     description="Claude usage limits in your bar")
    parser.add_argument("--once", action="store_true",
                        help="print current state to stdout and exit")
    parser.add_argument("--warmup-once", action="store_true",
                        help="run one gate-checked warmup pass and exit")
    parser.add_argument("--preview-popover", nargs="?", const="", metavar="PATH",
                        help="render the popover to a PNG and exit (needs "
                             "pycairo; works on any OS)")
    parser.add_argument("--demo", action="store_true",
                        help="with --preview-popover: sample data covering "
                             "every card state, no claude-swap needed")
    parser.add_argument("--scheme", choices=("dark", "light"), default="dark",
                        help="with --preview-popover: which appearance to "
                             "render (the panel follows the system's at run "
                             "time; this is how the other one gets reviewed)")
    parser.add_argument("--update", action="store_true",
                        help="fetch and apply the newest release, then restart")
    parser.add_argument("--check-update", action="store_true",
                        help="report whether a newer release is waiting "
                             "(exit 10 when one is)")
    parser.add_argument("--reset", action="store_true",
                        help="with --update: discard local drift (parked in a "
                             "rescue ref first) and re-install from scratch")
    parser.add_argument("--force", action="store_true",
                        help="with --update: re-apply even when already current")
    parser.add_argument("--presence-beat", action="store_true",
                        help="announce this device and refresh the per-account "
                             "device counts (the UIs run this on a timer)")
    parser.add_argument("--presence-leave", action="store_true",
                        help="withdraw this device so the others stop "
                             "counting it right away")
    parser.add_argument("--plans", action="store_true",
                        help="print each account's plan badge as JSON "
                             "(the macOS app's data source; output is "
                             "always JSON, --json is accepted for symmetry)")
    parser.add_argument("--openai", action="store_true",
                        help="print the OpenAI/ChatGPT accounts as JSON "
                             "(the macOS app's data source; output is "
                             "always JSON, --json is accepted for symmetry)")
    parser.add_argument("--remove-account", metavar="PROVIDER:ID",
                        help="remove an account and print a JSON result: "
                             "claude:<slot> deletes the claude-swap slot "
                             "(stored credential backup included), "
                             "openai:<email> forgets the remembered ChatGPT "
                             "card. The active account is always refused")
    parser.add_argument("--presence-status", action="store_true",
                        help="name the devices behind the counts, and say "
                             "whether this one is visible to them")
    parser.add_argument("--json", action="store_true",
                        help="with --check-update: print the result as JSON "
                             "(label/title/body/found) — this is how both UIs "
                             "get one shared answer instead of two copies")
    parser.add_argument("--update-interval", nargs="?", const="seconds",
                        metavar="FORMAT",
                        help="print how often this device should check for "
                             "updates: 'seconds' (default), 'cron' or "
                             "'minutes'. The installers use it to build "
                             "their timers")
    parser.add_argument("--print-config", metavar="FORMAT",
                        help="render ~/.config/ai-smartbar/config.env for an "
                             "agent file (plist|systemd|exec|winenv); the "
                             "installers use this to re-apply settings on "
                             "every update")
    parser.add_argument("--channel", metavar="NAME",
                        choices=("release", "main"),
                        help="with --update/--check-update: plan against this "
                             "release channel instead of "
                             "$SMARTBAR_UPDATE_CHANNEL. Windows' Scheduled "
                             "Task passes it here because a task carries no "
                             "environment block to hold it in")
    parser.add_argument("--version", action="version",
                        version=f"ai-smartbar {__version__}")
    args = parser.parse_args()
    # An explicit flag outranks both the inherited environment and config.env
    # (which may not set this key at all — it is RESERVED there precisely so
    # the installers stay the single source of the channel). Assigning into
    # os.environ rather than threading a parameter down keeps ONE resolution
    # path, update.channel(), instead of a second one that could disagree.
    if args.channel:
        os.environ["SMARTBAR_UPDATE_CHANNEL"] = args.channel
    if args.print_config:
        return print_config(args.print_config)
    if args.update_interval:
        return print_update_interval(args.update_interval)
    if args.check_update and args.json:
        import json as json_mod
        from smartbar.update_runner import check_now
        outcome = check_now()
        print(json_mod.dumps({"label": outcome.label, "title": outcome.title,
                              "body": outcome.body, "found": outcome.found}))
        return 0
    if args.once:
        return once()
    if args.warmup_once:
        from smartbar.warmup_runner import run_once
        return run_once()
    if args.preview_popover is not None:
        from smartbar.paint.popover_preview import render
        print(render(args.preview_popover, demo=args.demo,
                     scheme=args.scheme))
        return 0
    if args.update or args.check_update:
        from smartbar.update_runner import run_once as update_once
        return update_once(reset=args.reset, force=args.force,
                           check_only=args.check_update and not args.update)
    if args.presence_beat or args.presence_leave or args.presence_status:
        from smartbar.presence_runner import run_once as presence_once
        return presence_once(leave=args.presence_leave,
                             report=args.presence_status)
    if args.plans:
        import json as _json
        from smartbar.core import plan
        print(_json.dumps({"plans": plan.plans_by_email()}))
        return 0
    if args.openai:
        import json as _json
        from smartbar.core import codex
        print(_json.dumps(codex.payload()))
        return 0
    if args.remove_account:
        import json as _json
        from smartbar.core import account_removal
        ok, error = account_removal.remove(args.remove_account)
        print(_json.dumps({"ok": ok, "error": error}))
        return 0 if ok else 1
    if sys.platform == "darwin":
        from smartbar.macos.menubar import main as ui_main
    elif sys.platform == "win32":
        from smartbar.windows.tray import main as ui_main
    else:
        from smartbar.linux.tray import main as ui_main
    ui_main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
